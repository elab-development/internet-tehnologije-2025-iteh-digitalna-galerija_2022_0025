{
  "compilerOptions": {
    "target": "ESNext", 
    "module": "commonjs", 
    "moduleResolution": "node", 
    "esModuleInterop": true, 
    "allowSyntheticDefaultImports": true, 
    "strict": true, 
    "skipLibCheck": true, 
    "types": ["jest", "node", "react"], // Dodajemo "react" tipove za JSX podršku
    "jsx": "react" // Postavljamo opciju JSX na "react"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"], 
  "exclude": ["node_modules"]
}
